# DOME OS — ÚŘAD: example environment. Placeholders only — never commit real values.

# ---- PUBLIC (browser) — embedded into the client bundle, NOT secret ----
# Optional: if unset, the app falls back to the defaults in src/lib/supabase-config.ts
# (the existing DOME OS Supabase project and its public publishable key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- SERVER-ONLY (secret) — read via process.env inside server functions ----
# Required for: case assessment (DOME analysis), document reading, worker handoff summary.
# Without it: sign-in, case list, case creation and saving replies still work;
# AI features fail with "AI není nakonfigurována." and nothing is saved.
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Optional. Only "lovable-gateway" is implemented; any other value is rejected.
# AI_PROVIDER=lovable-gateway

# NEVER add a Supabase service_role / sb_secret_ key. The app does not use one.
